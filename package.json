    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.1",
    "serverless-http": "^4.0.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
